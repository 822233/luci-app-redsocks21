#!/bin/sh

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@redsocks2[-1]
	add ucitrack redsocks2
	set ucitrack.@redsocks2[-1].init=redsocks2
	commit ucitrack
	delete firewall.redsocks2
	set firewall.redsocks2=include
	set firewall.redsocks2.type=script
	set firewall.redsocks2.path=/usr/share/redsocks2/firewall.include
	set firewall.redsocks2.reload=1
	commit firewall
EOF

# Install a weekly updater without duplicating the cron entry on upgrades.
chmod 755 /usr/bin/redsocks2-update-chnroute 2>/dev/null || true
mkdir -p /etc/crontabs
touch /etc/crontabs/root
if ! grep -Fq '/usr/bin/redsocks2-update-chnroute' /etc/crontabs/root; then
	echo '23 4 * * 1 /usr/bin/redsocks2-update-chnroute --quiet >/dev/null 2>&1' >> /etc/crontabs/root
fi
/etc/init.d/cron restart >/dev/null 2>&1 || true

# Fetch the first list during installation. A failed download does not break
# package installation; the updater keeps any existing valid list untouched.
if [ -x /usr/bin/redsocks2-update-chnroute ]; then
	/usr/bin/redsocks2-update-chnroute --quiet || true
fi

rm -f /tmp/luci-indexcache
exit 0
